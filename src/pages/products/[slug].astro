---
import Layout from '../../layouts/Layout.astro';
import { getProductBySlug } from '../../utils/getProductBySlug.js';
import { getProducts } from '../../utils/getProduct.js';
import { getConfig } from '../../utils/getConfig.js';

export async function getStaticPaths() {
  const { data: products } = await getProducts();
  
  // Se revierte la línea de filtro adicional. 
  // Ahora se genera la ruta usando el slug o el fallback (producto-[id]), 
  // confiando en la lógica de fallback que tienes en getProducts().
  return products
    .map(product => ({
      params: { slug: product.slug }
    }));
}

const { slug } = Astro.params;

// Ejecutar ambas peticiones de datos en paralelo para optimizar el tiempo de build
const [
    { data: product, error: productError },
    { data: config, error: configError }
] = await Promise.all([
    getProductBySlug(slug),
    getConfig()
]);

// Manejar errores o producto no encontrado con redirección a 404
if (!product || productError) {
  return Astro.redirect('/404');
}

// Extraer el background del config, con un fallback seguro
const { background = null } = config; 
---

<Layout 
    title={`${product.name} - Detalles`} 
    description={product.shortDescription}
    background={background}
>
  <section class="py-16">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
        <div class="relative">
          <img 
            src={product.image} 
            alt={product.name}
            class="w-full h-auto rounded-2xl shadow-xl object-cover max-h-96 mx-auto"
          />
        </div>

        <div class="flex flex-col justify-center">
          <h1 class="text-3xl md:text-4xl font-bold text-amber-50 mb-3">
            {product.name}
          </h1>
          
          <p class="text-2xl font-bold text-amber-400 mb-4">
            ${product.price}
          </p>

          <div class="badge bg-amber-600 text-amber-50 text-xs font-semibold px-3 py-1 rounded-full inline-block mb-6">
            {product.category}
          </div>

          <p class="text-gray-300 mb-6 leading-relaxed">
            {product.shortDescription}
          </p>

          <div class="prose prose-invert max-w-none mb-8">
            <h2 class="text-xl font-semibold text-amber-50 mb-3">Descripción completa</h2>
            <div class="text-gray-300 whitespace-pre-line">
              {product.description}
            </div>
          </div>

          <button class="bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all duration-300 hover:shadow-xl hover:scale-105 active:scale-95 flex items-center justify-center gap-2 w-fit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            Añadir al carrito
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .badge {
    width: fit-content;
  }
</style>