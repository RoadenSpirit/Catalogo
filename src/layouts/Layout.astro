---
// src/layouts/Layout.astro
export interface Props {
  background?: string;
}

const { background } = Astro.props;
console.log('%c[Layout] Background recibido:', 'color: #10b981; font-weight: bold;', background);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Modern Product Catalog</title>
    <meta name="description" content="Discover amazing products in our modern catalog" />
  </head>

  <body class="min-h-screen">
    <div class="app-container">
      <!-- SOLO LA FOTO -->
      {background && (
        <div 
          class="background-image"
          style={`
            background-image: url("${background}");
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
          `}
        ></div>
      )}

      <!-- OVERLAY OSCURO SUAVE (para legibilidad del texto) -->
      {background && <div class="background-overlay"></div>}

      <!-- CONTENIDO -->
      <div class="content-wrapper">
        <slot />
      </div>
    </div>
  </body>
</html>

<style is:global>
  .app-container {
    min-height: 100vh;
    position: relative;
    background: transparent;
    overflow: hidden;
  }

  /* 1. IMAGEN DE FONDO */
  .background-image {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  /* 2. OVERLAY OSCURO (muy suave) */
  .background-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3); /* 30% negro → suave */
    z-index: -1;
    pointer-events: none;
  }

  .content-wrapper {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .background-image {
      background-attachment: scroll;
    }
  }
</style>