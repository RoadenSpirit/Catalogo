---
const { settings } = Astro.props;
---

<header class="header-container">
  <div class="logo-section">
    <div class="logo-circle">
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="24" cy="24" r="20" fill="url(#gradient1)" stroke="white" stroke-width="2"/>
        <path d="M16 24L20 28L32 16" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        <defs>
          <linearGradient id="gradient1" x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
            <stop stop-color="#667eea"/>
            <stop offset="1" stop-color="#764ba2"/>
          </linearGradient>
        </defs>
      </svg>
    </div>
    <div class="brand-info">
      <h1 class="brand-title">{settings.site_title}</h1>
      <p class="brand-subtitle">{settings.description}</p>
    </div>
  </div>
</header>

<style>
  .header-container {
    padding: 2rem 0 3rem 0;
    text-align: center;
    position: relative;
    z-index: 10;
  }
  
  .logo-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  
  .logo-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    animation: float 3s ease-in-out infinite;
  }
  
  .logo-circle:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
  }
  
  .brand-title {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
    letter-spacing: -0.02em;
  }
  
  .brand-subtitle {
    font-size: 1.1rem;
    color: #64748b;
    margin: 0;
    font-weight: 400;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  @media (max-width: 768px) {
    .brand-title {
      font-size: 2rem;
    }
    
    .brand-subtitle {
      font-size: 1rem;
    }
    
    .logo-circle {
      width: 70px;
      height: 70px;
    }
  }
</style>
</header>