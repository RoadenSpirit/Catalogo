---
import CartIcon from './CartIcon.jsx'; // 1. Importar el componente de React

export interface Props {
	title: string;
	subtitle: string;
	logo?: string;
}

const { title, subtitle, logo } = Astro.props;
---

<header class="py-10 md:py-16 text-center relative z-10">
	{/* Nuevo contenedor para el ícono del carrito en la esquina */}
	<div class="absolute top-5 right-5 z-20">
		{/* Renderiza el componente de React como una Isla.
            client:load asegura que se hidrate inmediatamente para acceder a Local Storage
            y mostrar el conteo tan pronto como sea posible.
        */}
		<CartIcon client:load />
	</div>

	<div class="flex flex-col items-center gap-5 max-w-4xl mx-auto px-4">
		<div
			class={[
				'w-24 h-24 md:w-28 md:h-28 rounded-full flex items-center justify-center shadow-xl shadow-golden-yellow/40 transition duration-300 ease-in-out animate-float overflow-hidden border-4 border-slate-800/50',
				logo ? 'bg-transparent' : 'bg-gradient-to-br from-golden-yellow to-yellow-600',
			].join(' ')}
		>
			{
				logo && (logo.startsWith('http') || logo.startsWith('/')) ? (
					<img
						src={logo}
						alt={`${title} Logo`}
						class="w-full h-full object-cover"
						loading="eager"
					/>
				) : (
					<svg
						width="56"
						height="56"
						viewBox="0 0 56 56"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						class="drop-shadow-md"
					>
						<circle cx="28" cy="28" r="24" fill="url(#gradient1)" stroke="white" stroke-width="2.5" />
						<path d="M18 28L23 33L38 18" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
						<defs>
							<linearGradient id="gradient1" x1="4" y1="4" x2="52" y2="52" gradientUnits="userSpaceOnUse">
								<stop stop-color="#ffde59" />
								<stop offset="1" stop-color="#e0b400" />
							</linearGradient>
						</defs>
					</svg>
				)
			}
		</div>

		<div class="max-w-2xl mx-auto">
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold bg-gradient-to-br from-golden-yellow to-yellow-600 bg-clip-text text-transparent leading-tight tracking-tight">
				{title}
			</h1>
			<p class="text-lg md:text-xl lg:text-2xl text-primary font-light opacity-90 mt-2 leading-relaxed">
				{subtitle}
			</p>
		</div>
	</div>
</header>

<style>
	/* Animación suave de flotación */
	@keyframes float {
		0%,
		100% {
			transform: translateY(0) rotate(0deg);
		}
		50% {
			transform: translateY(-12px) rotate(1deg);
		}
	}

	.animate-float {
		animation: float 4s ease-in-out infinite;
	}

	/* Mejora de legibilidad en pantallas grandes */
	@media (min-width: 768px) {
		.max-w-2xl h1 {
			line-height: 1.1;
		}
	}
</style>