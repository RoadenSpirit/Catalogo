---
import AddToCartButton from './AddToCartButton.jsx'; // 1. Importar la Isla

export interface Product {
    id: number;
    name: string;
    slug: string;
    image: string;
    price: number;
    category: string;
    shortDescription: string;
}

export interface Props {
    product: Product;
}

const { product } = Astro.props;

// 2. Definir las clases para pasarlas al componente React
const CATEGORY_BG_COLOR = 'bg-gray-200';
const CATEGORY_TEXT_COLOR = 'text-gray-700';
const BUTTON_BG_COLOR = 'bg-golden-yellow hover:bg-golden-yellow/90'; // Ahora amarillo con hover más oscuro
const PRICE_COLOR = 'text-product-orange'; // Usando el nuevo naranja

const ADD_TO_CART_CLASSES = `${BUTTON_BG_COLOR} text-gray-900 font-medium text-xs px-2.5 py-1.5 rounded-full shadow-md transition-all duration-200 hover:shadow-lg hover:scale-105 active:scale-95 flex items-center gap-1`;
---

<article class="group flex items-center w-full max-w-2xl mx-auto bg-milk-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-golden-yellow/20 hover:border-golden-yellow hover:-translate-y-1 h-auto sm:h-44 focus-visible:outline focus-visible:outline-2 focus-visible:outline-golden-yellow focus-visible:outline-offset-2">
  
    <div class="flex flex-col items-center flex-shrink-0 m-1.5 sm:m-2 pr-4 border-r border-gray-300">
    <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden border-4 border-golden-yellow shadow-2xl">
      <img
        src={product.image}
        alt={product.name}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>
    
        <span class={`${CATEGORY_BG_COLOR} ${CATEGORY_TEXT_COLOR} text-[9px] sm:text-xs font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-full shadow-md mt-2 text-center whitespace-normal leading-tight max-w-20`}>
      {product.category || 'Producto'}
    </span>
  </div>

    <div class="flex-1 flex flex-col justify-between p-2 sm:p-3 pr-3 sm:pr-4 min-w-0 h-full">
    
    <h3 class="text-sm sm:text-base font-bold text-gray-900 leading-tight tracking-tight break-words">
      {product.name}
    </h3>

    <p class="text-xs sm:text-sm text-gray-700 line-clamp-2 sm:line-clamp-3 leading-tight flex-1 mt-1">
      {product.shortDescription}
    </p>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mt-2 gap-2 sm:gap-3 border-t border-gray-300 pt-2">
      <span class={`text-lg sm:text-xl font-bold ${PRICE_COLOR} tracking-tight`}>
        ${product.price}
      </span>
      
      <div class="flex items-center gap-2">
        <AddToCartButton 
            client:only="react" 
            productData={{ 
                id: product.id, 
                name: product.name, 
                price: product.price, 
                slug: product.slug 
            }} 
            baseClasses={ADD_TO_CART_CLASSES}
        />
        
                <a
          href={`/products/${product.slug}`}
          class="bg-transparent border-2 border-gray-400 text-gray-700 hover:bg-gray-100 hover:border-gray-500 hover:text-gray-800 font-medium text-xs px-2.5 py-1.5 rounded-full shadow-md transition-all duration-200 hover:shadow-lg hover:scale-105 active:scale-95 flex items-center gap-1"
          aria-label={`Ver detalles de ${product.name}`}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
            <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          <span class="hidden sm:inline">Ver más</span>
          <span class="sm:hidden">Detalles</span>
        </a>
      </div>
    </div>
  </div>
</article>