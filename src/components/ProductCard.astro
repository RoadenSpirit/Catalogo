---
const { product } = Astro.props;

const categoryColors = {
  'Electronics': 'bg-amber-700',
  'Fashion': 'bg-rose-700',
  'Home &  Garden': 'bg-green-700',
  'Sports': 'bg-orange-700',
  'Books': 'bg-indigo-700',
  'Beauty': 'bg-pink-700',
  'default': 'bg-gray-600'
};

const bgColor = categoryColors[product.category] || categoryColors.default;
---

<article class="group flex items-center w-full max-w-2xl mx-auto bg-slate-900/90 backdrop-blur-sm rounded-2xl shadow-lg border border-gray-700/50 overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-amber-900/20 hover:-translate-y-1 h-40 sm:h-44">
  <!-- Izquierda: Imagen + Categoría debajo -->
  <div class="flex flex-col items-center flex-shrink-0 m-1.5 sm:m-2">
    <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden border-4 border-slate-800 shadow-2xl">
      <img
        src={product.image}
        alt={product.name}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>
    <span class={`${bgColor} text-[10px] sm:text-xs font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full text-amber-50 shadow-md mt-1.5 min-w-14 text-center`}>
      {product.category}
    </span>
  </div>

  <!-- Derecha: Contenido con distribución vertical optimizada -->
  <div class="flex-1 flex flex-col justify-between p-2 sm:p-3 pr-3 sm:pr-4 min-w-0 h-full">
    
    <!-- NOMBRE: Pegado arriba -->
    <h3 class="text-sm sm:text-base font-bold text-amber-50 leading-tight tracking-tight break-words">
      {product.name}
    </h3>

    <!-- DESCRIPCIÓN: Máximo espacio (flex-grow) -->
    <p class="text-xs sm:text-sm text-gray-300 line-clamp-2 sm:line-clamp-3 leading-tight flex-1 mt-1">
      {product.descripcion || 'Producto premium con materiales seleccionados y diseño exclusivo.'}
    </p>

    <!-- PRECIO + BOTÓN: Pegado abajo -->
    <div class="flex items-center justify-between mt-2">
      <span class="text-lg sm:text-xl font-bold text-amber-400 tracking-tight">
        ${product.price}
      </span>
      <button
        class="bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-amber-50 font-medium text-xs px-2.5 py-1.5 rounded-full shadow-md transition-all duration-200 hover:shadow-lg hover:scale-105 active:scale-95 flex items-center gap-1"
        aria-label={`Añadir ${product.name} al carrito`}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-amber-100">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-amber-100">
          <path d="M3 3h2l.5 3M7 6h14l-1.5 9H6M5 21a1 1 0 100-2 1 1 0 000 2zm13 0a1 1 0 100-2 1 1 0 000 2z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</article>