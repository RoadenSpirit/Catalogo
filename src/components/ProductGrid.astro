---
// src/components/ProductGrid.astro
import ProductCard from './ProductCard.astro';
import { getProducts } from '../utils/getProduct.js';
import { API_CONFIG } from '../config/api';

const { data: products, error, pagination } = await getProducts();
---

<section class="py-6">
  <div class="container max-w-7xl mx-auto px-3 sm:px-4">

    <!-- ERROR -->
    {error && (
      <div class="bg-slate-800/70 backdrop-blur-sm border border-dashed border-slate-600 rounded-2xl p-6 max-w-md mx-auto text-center">
        <p class="text-red-400 font-semibold text-base">{error.message}</p>
      </div>
    )}

    <!-- SIN PRODUCTOS -->
    {!error && products.length === 0 && (
      <div class="bg-slate-800/70 backdrop-blur-sm border border-dashed border-slate-600 rounded-2xl p-8 max-w-md mx-auto text-center">
        <svg class="w-14 h-14 text-gray-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
        </svg>
        <p class="text-gray-400 text-base">{API_CONFIG.errors.NO_PRODUCTS}</p>
      </div>
    )}

    <!-- PRODUCTOS -->
    {!error && products.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {products.map((product, index) => (
          <div
            class="animate-fade-in-up"
            style={`animation-delay: ${Math.min(index * 60, 500)}ms;`}
          >
            <ProductCard product={product} />
          </div>
        ))}
      </div>
    )}

    <!-- PAGINACIÓN -->
    {pagination.pageCount > 1 && (
      <div class="text-center mt-8">
        <p class="text-xs text-gray-500">
          Página {pagination.page} de {pagination.pageCount}
        </p>
      </div>
    )}
  </div>
</section>

<style is:global>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.5s ease-out forwards;
  }
</style>