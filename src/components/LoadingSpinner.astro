---
const { size = 'medium' } = Astro.props;
const sizeClasses = {
  small: 'h-4 w-4',
  medium: 'h-8 w-8',
  large: 'h-12 w-12'
};
---

<div class="flex justify-center items-center">
  <div class={`animate-spin rounded-full border-2 border-primary/20 border-t-primary ${sizeClasses[size]}`}>
  </div>
</div>

<style>
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  
  .animate-spin {
    animation: spin 1s linear infinite;
  }
</style>